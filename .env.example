# GEMINI_API_KEY: Optional for Gemini AI smart financial advisory calls.
# AI Studio automatically injects this at runtime from user secrets if configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Web server port (defaults to 3000)
PORT="3000"

# JWT_SECRET: Secret key for signing JSON Web Tokens
JWT_SECRET="super-secret-jwt-key-replace-in-production"

# MONGODB_URI: Optional MongoDB Atlas connection string.
# If omitted or offline, the app utilizes an embedded persistent JSON-backed MongoDB store.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.o1hexg9.mongodb.net/?appName=Cluster0
